# Copy to `.env` (git-ignored) and fill in locally. Placeholders only: never put a
# real value in this file. In CI, values come from GitHub Secrets; on the VPS,
# `.env` has permissions 600 (docs/RUNBOOK.md).

# --- LLM provider (ADR-0001) --------------------------------------------------
# Create the key in a dedicated OpenAI project with a hard monthly spend limit.
OPENAI_API_KEY=replace-me
# Only when switching the provider to Anthropic (a config change, no code change).
# ANTHROPIC_API_KEY=replace-me

# --- Tracing: Langfuse Cloud, EU region ---------------------------------------
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_HOST=https://cloud.langfuse.com

# --- API (apps/api/src/site_api/core/config.py) ---------------------------------
# Without APP_ENV the API behaves as production (no docs or schema). Local runs set development.
# Never copy this value to the server: production sets APP_ENV=production in Compose (ROADMAP 1.6).
APP_ENV=development
# Production only: the site origin(s) allowed to call the API (JSON list). Development also
# allows any http://localhost:<port>.
# CORS_ALLOW_ORIGINS=["https://ivanvasiunin.com"]
# LOG_LEVEL=INFO

# --- Database: Postgres 18 + pgvector (Docker Compose, ROADMAP 1.6) ------------
DATABASE_URL=postgresql+psycopg://site:replace-me@localhost:5432/site

# --- Claude Code tooling (optional) ---------------------------------------------
# Context7 MCP is configured at user scope; the key only raises its rate limits.
# CONTEXT7_API_KEY=replace-me
