# Copy to `.env` (git-ignored) and fill in locally. Placeholders only: never put a
# real value in this file. In CI, values come from GitHub Secrets; on the VPS,
# `.env` has permissions 600 (docs/RUNBOOK.md).

# --- LLM provider (ADR-0001) --------------------------------------------------
# Create the key in a dedicated OpenAI project with a hard monthly spend limit.
OPENAI_API_KEY=replace-me
# Only when switching the provider to Anthropic (a config change, no code change).
# ANTHROPIC_API_KEY=replace-me
# The answer model (ROADMAP 3.7; defaults in core/config.py: openai + gpt-6.1-terra).
# ANSWER_PROVIDER=anthropic
# ANSWER_MODEL=claude-haiku-5-5
# The router (ROADMAP 4.2) classifies every question first; defaults: openai + gpt-6-luna.
# ROUTER_PROVIDER=anthropic
# ROUTER_MODEL=claude-haiku-5-5
# Evals (ROADMAP 4.5): the judge model and the thresholds; defaults in core/config.py.
# EVAL_JUDGE_MODEL=gpt-6-luna
# EVAL_MIN_ROUTER_ACCURACY=0.9
# Every answer model needs a price (USD per 1M tokens) for the cost estimate; the default table
# has gpt-6.1-terra, gpt-6-luna, claude-haiku-5-5 and claude-sonnet-5-5. JSON; it replaces the table:
# MODEL_PRICES={"gpt-6.1-terra": {"input": 1, "cached_input": 0.05, "output": 5}}
# Chat limits (SPEC §4.1): question length in characters, history turns sent to the model.
# MAX_QUESTION_CHARS=500
# HISTORY_MAX_TURNS=6
# HISTORY_TURN_MAX_CHARS=2000
# CHAT_TOTAL_TIMEOUT_S=60
# Abuse and spend limits (ROADMAP 4.1), checked before any model call. Per IP is the real limit;
# the daily budget is the estimated spend of all answers per UTC day (about 150 answers per $1).
# CHAT_REQUESTS_PER_MINUTE_PER_IP=6
# CHAT_REQUESTS_PER_DAY_PER_IP=60
# CHAT_STREAMS_PER_IP=2
# SESSION_MAX_QUESTIONS=30
# DAILY_BUDGET_USD=1.0

# --- Tracing: Langfuse Cloud, EU region ---------------------------------------
# Off unless both keys are set (ROADMAP 4.6); everything sent is masked first.
# LANGFUSE_PUBLIC_KEY=replace-me
# LANGFUSE_SECRET_KEY=replace-me
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- API (apps/api/src/site_api/core/config.py) ---------------------------------
# Without APP_ENV the API behaves as production (no docs or schema). Local runs set development.
# Never copy this value to the server: production sets APP_ENV=production in Compose (ROADMAP 1.6).
APP_ENV=development
# Production only: the site origin(s) allowed to call the API (JSON list). Development also
# allows any http://localhost:<port>.
# CORS_ALLOW_ORIGINS=["https://ivanvasiunin.com"]
# LOG_LEVEL=INFO

# --- Database: Postgres 18 + pgvector (Docker Compose, ROADMAP 1.6) ------------
DATABASE_URL=postgresql+psycopg://site:replace-me@localhost:5432/site

# --- Ingestion (python -m site_api.ingestion --estimate | --apply) ------------
# Public READMEs that join the knowledge base (JSON list; owner must be GITHUB_OWNER). The
# default in config.py is NumbersValidator only; setting this replaces the whole list.
# GITHUB_READMES=[{"repo":"IvanVasiunin/NumbersValidator","project":"numbers-validator","note":"README of NumbersValidator, a production web tool Ivan built at Liketelecom."}]

# --- Claude Code tooling (optional) ---------------------------------------------
# Context7 MCP is configured at user scope; the key only raises its rate limits.
# CONTEXT7_API_KEY=replace-me
