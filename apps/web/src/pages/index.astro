---
// AI mode (SPEC §2): the chat island with Elio. `client:load`: the input is the page's main control, so
// it hydrates right away. The island's server HTML is the no-JS page: the greeting, the example
// questions as `/?q=` links and a pointer to the CV. The knowledge map (ADR-0012) stands to its right
// from 80rem and hydrates only there (`client:media`): phones never load its code or its data.
// The way to the CV is the mode switch's Text mode tab (Ivan, 2026-11-05: no CV button in the chat).
import BaseLayout from '../layouts/BaseLayout.astro';
import AiModeLayout from '../components/AiModeLayout/AiModeLayout.astro';
import { Chat } from '../islands/Chat';
import { KnowledgeMap } from '../islands/KnowledgeMap';
import { chatRestoringHeadScript } from '../lib/chat/restoring';
import { cspHash } from '../lib/csp';

// Hides the topic cards before first paint while a kept conversation waits for its restore
// (lib/chat/restoring.ts). Inline, so its hash goes into the page's CSP, like /cv's view script.
const RESTORING_SCRIPT = chatRestoringHeadScript();
Astro.csp?.insertScriptHash(cspHash(RESTORING_SCRIPT));
---

<BaseLayout
  title="Ivan Vasiunin — ask Elio"
  description="Ivan Vasiunin, Senior Frontend Engineer moving into AI engineering. Ask Elio, his AI assistant, about his experience, skills and projects."
  scrollTop={false}
  fit
>
  <script slot="head" is:inline set:html={RESTORING_SCRIPT} />
  <AiModeLayout>
    <Chat client:load />
    <KnowledgeMap client:media="(min-width: 80rem)" />
  </AiModeLayout>
</BaseLayout>
