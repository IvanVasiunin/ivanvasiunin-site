---
// AI mode (SPEC §2): the chat island with Elio. `client:load`: the input is the page's main control, so
// it hydrates right away. The island's server HTML is the no-JS page: the greeting, the example
// questions as `/?q=` links and a pointer to the CV. The vector-space island arrives in Phase 6.
// The way to the CV is the mode switch's Text mode tab (Ivan, 2026-11-05: no CV button in the chat).
import BaseLayout from '../layouts/BaseLayout.astro';
import { Chat } from '../islands/Chat';
---

<BaseLayout
  title="Ivan Vasiunin — ask Elio"
  description="Ask Elio, an AI assistant, about Ivan Vasiunin's experience, skills and projects."
  scrollTop={false}
  fit
>
  <Chat client:load />
</BaseLayout>
