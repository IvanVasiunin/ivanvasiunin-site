---
// AI mode (SPEC §2): the chat island with Elio. `client:load`: the input is the page's main control, so
// it hydrates right away. The island's server HTML is the no-JS page: the introduction, the example
// questions as `/?q=` links and a pointer to the CV. The vector-space island arrives in Phase 6.
import Button from '../components/Button/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Chat } from '../islands/Chat';
---

<BaseLayout
  title="Ivan Vasiunin — ask Elio"
  description="Ask Elio, an AI assistant, about Ivan Vasiunin's experience, skills and projects."
  scrollTop={false}
>
  {/* The CV button is static markup in the island's intro (a named slot becomes the `cv` prop): the
  quick way to the text mode, with or without JS. */}
  <Chat client:load>
    <Button slot="cv" href="/cv">
      Read the CV
    </Button>
  </Chat>
</BaseLayout>
