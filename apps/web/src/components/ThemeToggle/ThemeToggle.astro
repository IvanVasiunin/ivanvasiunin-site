---
// Theme toggle (SPEC US-X1): a toggle button between the light and dark themes. Until the first click
// the page is dark. Not a React island: a tiny module script, so /cv ships no framework
// runtime. The icon (sun or moon, the visible theme) is pure CSS, keyed on the root `data-theme` that the
// head script sets before first paint, so it never flashes. Without JS the button is hidden
// (`scripting: none`) and the default, dark, applies.
//
// Accessibility: the name stays "Dark theme" and `aria-pressed` says whether it is on; screen readers
// announce the pressed state when it changes. The server renders `false`; the script corrects it on load.
import './ThemeToggle.scss';
---

<button
  class="theme-toggle"
  type="button"
  aria-label="Dark theme"
  aria-pressed="false"
  data-theme-toggle
>
  <svg
    class="theme-toggle__icons"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      {/* "Frosted glass" icons (styles/README.md → Icons). User-space gradients: the sun's rays are
      separate thin shapes, and one gradient across the whole icon keeps them in one light. */}
      <linearGradient
        id="theme-toggle-sun"
        gradientUnits="userSpaceOnUse"
        x1="4"
        y1="4"
        x2="20"
        y2="20"
      >
        <stop class="theme-toggle__stop-sun-1" offset="0"></stop>
        <stop class="theme-toggle__stop-sun-2" offset="0.55"></stop>
        <stop class="theme-toggle__stop-sun-3" offset="1"></stop>
      </linearGradient>
      <linearGradient id="theme-toggle-moon" x1="0" y1="0" x2="1" y2="1">
        <stop class="theme-toggle__stop-moon-1" offset="0"></stop>
        <stop class="theme-toggle__stop-moon-2" offset="0.55"></stop>
        <stop class="theme-toggle__stop-moon-3" offset="1"></stop>
      </linearGradient>
    </defs>
    <g class="theme-toggle__icon theme-toggle__icon--light">
      <g class="theme-toggle__shape" fill="url(#theme-toggle-sun)">
        <rect x="11.1" y="1.6" width="1.8" height="3.2" rx="0.9"></rect>
        <rect
          x="11.1"
          y="1.6"
          width="1.8"
          height="3.2"
          rx="0.9"
          transform="rotate(45 12 12)"
        ></rect>
        <rect
          x="11.1"
          y="1.6"
          width="1.8"
          height="3.2"
          rx="0.9"
          transform="rotate(90 12 12)"
        ></rect>
        <rect
          x="11.1"
          y="1.6"
          width="1.8"
          height="3.2"
          rx="0.9"
          transform="rotate(135 12 12)"
        ></rect>
        <rect
          x="11.1"
          y="1.6"
          width="1.8"
          height="3.2"
          rx="0.9"
          transform="rotate(180 12 12)"
        ></rect>
        <rect
          x="11.1"
          y="1.6"
          width="1.8"
          height="3.2"
          rx="0.9"
          transform="rotate(225 12 12)"
        ></rect>
        <rect
          x="11.1"
          y="1.6"
          width="1.8"
          height="3.2"
          rx="0.9"
          transform="rotate(270 12 12)"
        ></rect>
        <rect
          x="11.1"
          y="1.6"
          width="1.8"
          height="3.2"
          rx="0.9"
          transform="rotate(315 12 12)"
        ></rect>
        <circle class="theme-toggle__sun-core" cx="12" cy="12" r="4.6"></circle>
      </g>
      <path class="theme-toggle__glint" d="M9.3 10.6a3.2 3.2 0 0 1 3.1-2.4"></path>
    </g>
    <g class="theme-toggle__icon theme-toggle__icon--dark">
      <path
        class="theme-toggle__shape"
        fill="url(#theme-toggle-moon)"
        d="M14.6 3.3a8.6 8.6 0 1 0 6.1 13.5A7.1 7.1 0 0 1 14.6 3.3Z"
      ></path>
      <path
        class="theme-toggle__rim"
        d="M14.6 3.3a8.6 8.6 0 1 0 6.1 13.5A7.1 7.1 0 0 1 14.6 3.3Z"
      ></path>
      <path
        class="theme-toggle__star"
        d="M19.4 3Q19.8 4.8 21.6 5.2Q19.8 5.6 19.4 7.4Q19 5.6 17.2 5.2Q19 4.8 19.4 3Z"
      ></path>
    </g>
  </svg>
</button>

<script>
  import {
    THEME_COLOR,
    THEME_STORAGE_KEY,
    applyTheme,
    oppositeTheme,
    parseTheme,
    readStoredTheme,
    resolveTheme,
    storeTheme,
    type Theme,
  } from '../../lib/theme/theme';

  const getStorage = (): Storage => window.localStorage;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (button) {
    // The explicit choice; `null` until the first click (or while nothing is stored): dark.
    let stored: Theme | null = readStoredTheme(getStorage, THEME_STORAGE_KEY);

    const renderPressed = (): void => {
      const visible = resolveTheme(stored);
      button.setAttribute('aria-pressed', String(visible === 'dark'));
    };
    const render = (): void => {
      applyTheme(document, stored, THEME_COLOR);
      renderPressed();
    };

    render();
    button.addEventListener('click', () => {
      stored = oppositeTheme(resolveTheme(stored));
      storeTheme(getStorage, THEME_STORAGE_KEY, stored);
      render();
    });
    // Another tab changed the choice (`key === null`: that tab cleared all storage).
    window.addEventListener('storage', (event) => {
      if (event.key !== THEME_STORAGE_KEY && event.key !== null) return;
      stored = parseTheme(event.key === null ? null : event.newValue);
      render();
    });
    // Re-read the choice when a page is shown after it was prepared: back from bfcache, or activated
    // after a prerender (speculation rules in BaseLayout), when the choice may have changed meanwhile.
    // With blocked storage the stored value cannot be read, so keep the choice made on this page.
    const syncFromStorage = (): void => {
      try {
        stored = parseTheme(getStorage().getItem(THEME_STORAGE_KEY));
      } catch {
        return;
      }
      render();
    };
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) syncFromStorage();
    });
    document.addEventListener('prerenderingchange', syncFromStorage);
  }
</script>
