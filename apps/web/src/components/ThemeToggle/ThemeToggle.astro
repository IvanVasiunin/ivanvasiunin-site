---
// Theme toggle (SPEC US-X1): a toggle button between the light and dark themes. Until the first click
// the page follows the system theme. Not a React island: a tiny module script, so /cv ships no framework
// runtime. The icon (sun or moon, the visible theme) is pure CSS, keyed on the root `data-theme` that the
// head script sets before first paint, so it never flashes. Without JS the button is hidden
// (`scripting: none`) and the system theme applies.
//
// Accessibility: the name stays "Dark theme" and `aria-pressed` says whether it is on; screen readers
// announce the pressed state when it changes. The server renders `false`; the script corrects it on load.
import './ThemeToggle.scss';
---

<button
  class="theme-toggle"
  type="button"
  aria-label="Dark theme"
  aria-pressed="false"
  data-theme-toggle
>
  <svg
    class="theme-toggle__icons"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      {/* One gradient across the whole icon, not one per shape (the sun's rays are separate shapes). */}
      <linearGradient
        id="theme-toggle-gradient"
        gradientUnits="userSpaceOnUse"
        x1="2"
        y1="2"
        x2="22"
        y2="22"
      >
        <stop class="theme-toggle__stop-start" offset="0"></stop>
        <stop class="theme-toggle__stop-end" offset="1"></stop>
      </linearGradient>
    </defs>
    <g class="theme-toggle__icon theme-toggle__icon--light" fill="url(#theme-toggle-gradient)">
      <circle cx="12" cy="12" r="4.5"></circle>
      <rect x="11" y="1" width="2" height="4" rx="1"></rect>
      <rect x="11" y="1" width="2" height="4" rx="1" transform="rotate(45 12 12)"></rect>
      <rect x="11" y="1" width="2" height="4" rx="1" transform="rotate(90 12 12)"></rect>
      <rect x="11" y="1" width="2" height="4" rx="1" transform="rotate(135 12 12)"></rect>
      <rect x="11" y="1" width="2" height="4" rx="1" transform="rotate(180 12 12)"></rect>
      <rect x="11" y="1" width="2" height="4" rx="1" transform="rotate(225 12 12)"></rect>
      <rect x="11" y="1" width="2" height="4" rx="1" transform="rotate(270 12 12)"></rect>
      <rect x="11" y="1" width="2" height="4" rx="1" transform="rotate(315 12 12)"></rect>
    </g>
    <g class="theme-toggle__icon theme-toggle__icon--dark" fill="url(#theme-toggle-gradient)">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </g>
  </svg>
</button>

<script>
  import {
    THEME_COLOR,
    THEME_STORAGE_KEY,
    applyTheme,
    oppositeTheme,
    parseTheme,
    readStoredTheme,
    resolveTheme,
    storeTheme,
    type Theme,
  } from '../../lib/theme/theme';

  const getStorage = (): Storage => window.localStorage;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (button) {
    // The explicit choice; `null` until the first click (or while nothing is stored): follow the system.
    let stored: Theme | null = readStoredTheme(getStorage, THEME_STORAGE_KEY);

    const render = (): void => {
      applyTheme(document, stored, THEME_COLOR);
      const visible = resolveTheme(stored, systemDark.matches);
      button.setAttribute('aria-pressed', String(visible === 'dark'));
    };

    render();
    button.addEventListener('click', () => {
      stored = oppositeTheme(resolveTheme(stored, systemDark.matches));
      storeTheme(getStorage, THEME_STORAGE_KEY, stored);
      render();
    });
    // The system theme changed while there is no explicit choice: the CSS follows it, the state too.
    systemDark.addEventListener('change', render);
    // Another tab changed the choice (`key === null`: that tab cleared all storage).
    window.addEventListener('storage', (event) => {
      if (event.key !== THEME_STORAGE_KEY && event.key !== null) return;
      stored = parseTheme(event.key === null ? null : event.newValue);
      render();
    });
    // Back from bfcache: the choice may have changed in another page meanwhile. With blocked storage
    // the stored value cannot be read, so keep the choice made on this page instead of resetting it.
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      try {
        stored = parseTheme(getStorage().getItem(THEME_STORAGE_KEY));
      } catch {
        return;
      }
      render();
    });
  }
</script>
