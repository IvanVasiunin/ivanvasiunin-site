---
// The privacy page's side card (Ivan's pick, 2026-11-07: "B" with the fact tiles of "A"): Elio, a
// masking demo and four facts at a glance.
//
// The demo runs the server's masking patterns (lib/privacy/mask.ts, kept equal to
// services/masking.py by shared test cases) in the browser on whatever the visitor types, and shows
// what the statistics and the traces would keep. Nothing typed here is sent anywhere: the script
// below has no network code.
//
// Without JS the card shows a worked example: the textarea is read-only and the output is rendered
// at build time from the same sample. The script makes the textarea editable.
//
// Elio is the React avatar rendered to static HTML (no hydration, no React on this page): it
// breathes and blinks by CSS; the script lets its eyes follow the mouse (lookAt.ts).
import { ElioAvatar } from '../ElioAvatar';
import { maskParts } from '../../lib/privacy/mask';
import './PrivacyDemo.scss';

interface Props {
  /** How long the statistics and the traces are kept (the page's single source for the number). */
  readonly retentionDays: number;
}

const { retentionDays } = Astro.props;

const SAMPLE = "Hi! I'm Anna (anna.k@example.com, www.anna-dev.io). Which stack does Ivan use?";
/** The same limit as the chat input: a question longer than this never reaches the server. */
const MAX_LENGTH = 1000;
---

<div class="privacy-demo">
  <div class="privacy-demo__head">
    <ElioAvatar size="lg" live named={false} />
    <div>
      <h2 class="privacy-demo__title">See what the server keeps</h2>
      <p class="privacy-demo__lead">
        Type a question: masking runs right here, in your browser. Nothing is sent.
      </p>
    </div>
  </div>

  <label class="privacy-demo__label" for="privacy-demo-input">
    A question to Elio
  </label>
  <textarea
    class="privacy-demo__input"
    id="privacy-demo-input"
    rows="3"
    maxlength={MAX_LENGTH}
    spellcheck="false"
    readonly
    aria-describedby="privacy-demo-output"
    data-privacy-demo-input
  >{SAMPLE}</textarea>

  <p class="privacy-demo__divider">Kept for {retentionDays} days</p>
  <p
    class="privacy-demo__output"
    id="privacy-demo-output"
    data-empty="Type something above."
    data-privacy-demo-output
  >
    {maskParts(SAMPLE).map((part) =>
      part.kind === 'text' ? (
        part.text
      ) : (
        <span class="privacy-demo__mask" data-kind={part.kind}>{`[${part.kind}]`}</span>
      ),
    )}
  </p>
  <output class="privacy-demo__status" data-privacy-demo-status></output>
  <p class="privacy-demo__note">
    Emails, phone numbers and links are replaced. Names like “Anna” have no pattern to find, so they
    stay: keep them out of your questions.
  </p>

  <ul class="privacy-demo__facts">
    <li class="privacy-demo__fact">
      <strong class="privacy-demo__value">{retentionDays} days</strong>
      <span class="privacy-demo__caption">then statistics and traces are deleted</span>
    </li>
    <li class="privacy-demo__fact">
      <strong class="privacy-demo__value">0</strong>
      <span class="privacy-demo__caption">cookies, analytics or ad trackers</span>
    </li>
    <li class="privacy-demo__fact">
      <strong class="privacy-demo__value">Memory only</strong>
      <span class="privacy-demo__caption">your IP address, never written down</span>
    </li>
    <li class="privacy-demo__fact">
      <strong class="privacy-demo__value">EU</strong>
      <span class="privacy-demo__caption">where the masked traces are hosted</span>
    </li>
  </ul>
</div>

<script>
  import { followPointer } from '../ElioAvatar/lookAt';
  import { type MaskPart, maskParts, placeholder } from '../../lib/privacy/mask';

  const input = document.querySelector<HTMLTextAreaElement>('[data-privacy-demo-input]');
  const output = document.querySelector<HTMLElement>('[data-privacy-demo-output]');
  const avatar = document.querySelector<SVGSVGElement>('.privacy-demo .elio-avatar__svg');

  const status = document.querySelector<HTMLElement>('[data-privacy-demo-status]');
  /** How long typing must pause before the status announces the result (no noise per key). */
  const ANNOUNCE_AFTER_MS = 700;

  /**
   * The masked text as nodes. A chip for a piece that was not masked in the previous render gets
   * `data-new` (it pops in); the others stay still, so typing never makes every chip jump.
   */
  function render(parts: readonly MaskPart[], before: ReadonlySet<string>): Node[] {
    return parts.map((part) => {
      if (part.kind === 'text') return document.createTextNode(part.text);
      const mask = document.createElement('span');
      mask.className = 'privacy-demo__mask';
      mask.dataset['kind'] = part.kind;
      if (!before.has(`${part.kind}:${part.text}`)) mask.dataset['new'] = '';
      mask.textContent = placeholder(part.kind);
      return mask;
    });
  }

  const maskedPieces = (parts: readonly MaskPart[]): Set<string> =>
    new Set(
      parts.filter((part) => part.kind !== 'text').map((part) => `${part.kind}:${part.text}`),
    );

  if (input && output) {
    input.readOnly = false;
    let shown = maskedPieces(maskParts(input.value));
    output.replaceChildren(...render(maskParts(input.value), shown));
    // A new frame per keystroke at most: typing fast never queues work.
    let frame = 0;
    let announce = 0;
    input.addEventListener('input', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const parts = maskParts(input.value);
        output.replaceChildren(...render(parts, shown));
        shown = maskedPieces(parts);
      });
      window.clearTimeout(announce);
      announce = window.setTimeout(() => {
        if (status) status.textContent = `Kept: ${output.textContent}`;
      }, ANNOUNCE_AFTER_MS);
    });
  }
  if (avatar) followPointer(avatar);
</script>
