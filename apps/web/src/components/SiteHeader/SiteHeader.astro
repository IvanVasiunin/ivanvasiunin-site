---
// Site header: a floating bar with a gradient border. Three columns from left to right: the brand, the
// navigation slot (mode switch, centred) and the actions slot (theme toggle).
import './SiteHeader.scss';
---

<header class="site-header">
  <div class="site-header__bar">
    <a class="site-header__brand" href="/">
      <svg
        class="site-header__mark"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <linearGradient
            id="site-header-mark-gradient"
            gradientUnits="userSpaceOnUse"
            x1="2"
            y1="22"
            x2="22"
            y2="2"
          >
            <stop class="site-header__mark-stop-start" offset="0"></stop>
            <stop class="site-header__mark-stop-end" offset="1"></stop>
          </linearGradient>
        </defs>
        {/* A chart reticle, like the celestial chart in the backdrop: two rings with cardinal ticks and
        a planet on the inner ring (its orbit). On hover the planet travels along the orbit. */}
        <g
          class="site-header__reticle"
          fill="none"
          stroke="url(#site-header-mark-gradient)"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="9" stroke-width="1.4"></circle>
          <circle cx="12" cy="12" r="5" stroke-width="1" opacity="0.7"></circle>
          <path d="M12 1v2.6M12 20.4V23M1 12h2.6M20.4 12H23" stroke-width="1.4"></path>
        </g>
        <g class="site-header__planet" fill="url(#site-header-mark-gradient)">
          <circle cx="15.54" cy="8.46" r="2.1"></circle>
        </g>
      </svg>
      <span class="site-header__name">Ivan Vasiunin</span>
    </a>
    <div class="site-header__nav">
      <slot name="nav" />
    </div>
    <div class="site-header__actions">
      <slot name="actions" />
    </div>
  </div>
</header>
