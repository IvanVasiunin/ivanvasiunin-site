---
// Site header: a floating bar with a gradient border, the brand mark and a slot for page actions
// (theme toggle; mode switcher in ROADMAP 1.2).
import './SiteHeader.scss';
---

<header class="site-header">
  <div class="site-header__bar">
    <a class="site-header__brand" href="/">
      <svg
        class="site-header__mark"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <linearGradient id="site-header-mark-gradient" x1="0" y1="0" x2="1" y2="1">
            <stop class="site-header__mark-stop-start" offset="0"></stop>
            <stop class="site-header__mark-stop-end" offset="1"></stop>
          </linearGradient>
        </defs>
        <path
          d="M12 1.5l2.6 7.9 7.9 2.6-7.9 2.6L12 22.5l-2.6-7.9L1.5 12l7.9-2.6z"
          fill="url(#site-header-mark-gradient)"
        ></path>
      </svg>
      <span class="site-header__name">Ivan Vasiunin</span>
    </a>
    <div class="site-header__actions">
      <slot name="actions" />
    </div>
  </div>
</header>
