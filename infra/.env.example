# Copy to infra/.env (git-ignored) for `docker compose -f infra/docker-compose.yml`.
# Placeholders only. On the server this file is /opt/site/.env with permissions 600 (docs/RUNBOOK.md).

# The site's domain. `localhost` gives a local TLS certificate from Caddy's own CA.
SITE_ADDRESS=localhost
# Database password (used by db and api). Letters and digits only: it goes into a URL.
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=replace-me
# Development only (docker-compose.dev.yml): the read-only `mcp_reader` role for Postgres MCP.
# Use development-only passwords on a development machine, never the production one.
POSTGRES_MCP_PASSWORD=replace-me

# The model provider key (a dedicated OpenAI project with a hard spend limit, RUNBOOK §5).
# The api service will not start without it.
OPENAI_API_KEY=replace-me

# Images: local builds by default; on the server, GHCR names and the release tag (ROADMAP 1.7).
# WEB_IMAGE=ghcr.io/<owner>/ivanvasiunin-site-web
# API_IMAGE=ghcr.io/<owner>/ivanvasiunin-site-api
# IMAGE_TAG=<git sha>
