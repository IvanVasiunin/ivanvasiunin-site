{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm --filter * run *)",
      "Bash(pnpm --dir * run *)",
      "Bash(pnpm --dir * exec *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm check*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm e2e*)",
      "Bash(pnpm audit*)",
      "Bash(pnpm list*)",
      "Bash(pnpm why *)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv lock --check*)",
      "Bash(uv tree*)",
      "Bash(node scripts/*)",
      "Bash(node .claude/hooks/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(gitleaks *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose config*)",
      "Bash(docker compose logs*)",
      "PowerShell(pnpm run *)",
      "PowerShell(pnpm --filter * run *)",
      "PowerShell(pnpm --dir * run *)",
      "PowerShell(pnpm --dir * exec *)",
      "PowerShell(pnpm exec *)",
      "PowerShell(pnpm check*)",
      "PowerShell(pnpm lint*)",
      "PowerShell(pnpm test*)",
      "PowerShell(pnpm build*)",
      "PowerShell(pnpm e2e*)",
      "PowerShell(pnpm audit*)",
      "PowerShell(uv run *)",
      "PowerShell(uv sync*)",
      "PowerShell(node scripts/*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(gitleaks *)",
      "PowerShell(docker compose ps*)",
      "PowerShell(docker compose config*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./data/raw/**)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./**/.env.development)",
      "Edit(./**/.env.production)",
      "Edit(./**/.env.test)",
      "Edit(./data/raw/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gitconfig)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git clean -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit* -n*)",
      "Bash(*--no-verify*)",
      "Bash(*LEFTHOOK=0*)",
      "Bash(*LEFTHOOK=false*)",
      "Bash(*core.hooksPath*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "PowerShell(git push*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git rebase*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git commit --no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit* -n*)",
      "PowerShell(*--no-verify*)",
      "PowerShell(*LEFTHOOK*)",
      "PowerShell(*core.hooksPath*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(Remove-Item * -r *)"
    ],
    "ask": [
      "Edit(data/**)",
      "Bash(uv run * site_api.evals*)",
      "Bash(uv run * site_api.ingestion*)",
      "PowerShell(uv run * site_api.evals*)",
      "PowerShell(uv run * site_api.ingestion*)",
      "Bash(git commit *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "PowerShell(git commit *)",
      "PowerShell(pnpm add *)",
      "PowerShell(uv add *)",
      "PowerShell(docker compose up*)",
      "PowerShell(docker compose down*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-secrets.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-file.mjs"],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-fast-checks.mjs"],
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
